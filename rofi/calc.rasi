/* Overrides for `rofi -show calc` (see calc.sh). */
@theme "theme.rasi"

window {
	width: 520px;
}

mainbox {
	children: [ inputbar, message, listview ];
}

entry {
	placeholder: "Expression, e.g. 3 GiB to MB, sqrt(2)*pi, 20% of 85";
}

/* Live result / hint box. */
message {
	border-color: @wp-success;
}

textbox {
	padding:    10px 14px;
	font:       "JetBrainsMono Nerd Font Propo 13";
	text-color: @wp-foreground;
}

listview {
	lines:     6;
	scrollbar: false;
}

element {
	children: [ element-text ];
}

/* First row is the live result; history rows follow. */
element-text {
	font: "JetBrainsMono Nerd Font Propo 12";
}
