configuration {
	modes: "window,drun,run,ssh";
	show-icons: true;
	icon-theme: "Papirus";
	drun-match-fields: "name,generic,categories";
	combi-hide-mode-prefix: true;
	display-combi: "󰍉";
	display-drun: "󰀻";
	display-run: "";
	display-window: "󰖲";
	display-ssh: "󰣀";
	display-filebrowser: "󰉋";
	filebrowser {
		directories-first: true;
		sorting-method:    "name";
	}
}

@theme "theme.rasi"
